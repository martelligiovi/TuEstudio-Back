# Local/development defaults
# Copy to .env for local runs. Do not commit real secrets.

# Cloud Run sets PORT automatically. Keep 8080 for local runs.
PORT=8080

# PostgreSQL / Neon
# Neon JDBC URL format: jdbc:postgresql://<host>/<db>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tuestudio
SPRING_DATASOURCE_USERNAME=tuestudio
SPRING_DATASOURCE_PASSWORD=tuestudio
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=3
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false

# OAuth providers
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
LINKEDIN_CLIENT_ID=replace-with-linkedin-client-id
LINKEDIN_CLIENT_SECRET=replace-with-linkedin-client-secret

# Application secrets. Use long random values in production.
JWT_SECRET=replace-with-at-least-32-random-characters
OAUTH2_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Public URLs
APP_BASE_URL=http://localhost:8080
OAUTH2_FRONTEND_REDIRECT=http://localhost:5173/oauth2/callback
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cookies: keep false locally, true behind HTTPS/custom domain.
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# Optional local demo data. Uncomment for local demo/admin seeders.
# Do not set dev in production.
# SPRING_PROFILES_ACTIVE=dev
